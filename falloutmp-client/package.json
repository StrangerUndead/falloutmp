{
  "name": "falloutmp-client",
  "version": "0.1.0",
  "private": true,
  "description": "FalloutMP client: Fallout 4 sync services on top of the falloutPlatform native API",
  "license": "GPL-3.0-only",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test 'build/test/**/*.test.js'",
    "bundle": "esbuild src/runtime/main.ts --bundle --format=iife --target=es2020 --platform=neutral --main-fields=main,module --outfile=build/falloutmp-client.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
