{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "falloutmp",
  "homepage": "https://github.com/strangerundead/falloutmp",
  "description": "Multiplayer framework for Fallout 4",
  "dependencies": [
    "cmakerc",
    "nlohmann-json",
    "zlib",
    "spdlog",
    "catch2",
    "simdjson",
    "makeid",
    "libzippp",
    "antigo",
    "prometheus-cpp-lite",
    "slikenet",
    "quickjs-ng",
    "libsodium",
    {
      "name": "mongo-cxx-driver",
      "platform": "!emscripten"
    },
    {
      "name": "node-addon-api",
      "platform": "!emscripten"
    },
    {
      "name": "rsm-bsa",
      "platform": "!osx & !emscripten"
    }
  ]
}
